[Unit]
Description=AutoDealership.SI customer onboarding
After=network-online.target
[Service]
DynamicUser=yes
EnvironmentFile=/etc/autodealership-onboarding.env
EnvironmentFile=/etc/autodealership-clerk.env
EnvironmentFile=-/opt/business-demo-tools/voice-provider.env
ExecStart=/usr/bin/python3 /opt/autodealership-onboarding/server.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
